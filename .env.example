# Local PostgreSQL container
POSTGRES_DB=solar
POSTGRES_USER=solar
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# Server-only application configuration
DATABASE_URL=postgresql://solar:replace-with-a-strong-local-password@127.0.0.1:5432/solar
PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-output-from-npm-run-auth-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated origins used for LAN or preview development.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.123:3000

# LocalStack is local-only; production uses Hetzner through the same S3 adapter.
LOCALSTACK_GATEWAY_PORT=4566
# Keep loopback for this computer only. Use 0.0.0.0 temporarily for LAN testing.
LOCALSTACK_BIND_ADDRESS=127.0.0.1

# Server-only catalog storage. LocalStack's test credentials are not production secrets.
# Keep the provider/key data model unchanged when moving to another S3-compatible service.
# For iPhone/LAN testing, replace 127.0.0.1 with this computer's LAN IP in both URLs.
CATALOG_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:4566/solar-catalog/
CATALOG_STORAGE_S3_ENDPOINT=http://127.0.0.1:4566
CATALOG_STORAGE_BROWSER_ORIGIN=
CATALOG_STORAGE_S3_REGION=us-east-1
CATALOG_STORAGE_S3_BUCKET=solar-catalog
CATALOG_STORAGE_S3_ACCESS_KEY_ID=test
CATALOG_STORAGE_S3_SECRET_ACCESS_KEY=test

# Optional server-only Google OAuth credentials. Google sign-in is enabled only
# when both values are non-empty. Never use a NEXT_PUBLIC_ prefix.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional server-only Facebook OAuth credentials. Facebook sign-in is enabled
# only when both values are non-empty. Never use a NEXT_PUBLIC_ prefix.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Local Mailpit and server-only SMTP delivery
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Solar <no-reply@solar.local>"

# Production SMTP may set both credentials together. Local Mailpit needs neither.
# SMTP_USERNAME=
# SMTP_PASSWORD=
